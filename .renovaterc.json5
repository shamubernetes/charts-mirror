{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>shamubernetes/renovate-config:renovate.json5"],
  customManagers: [
    {
      customType: "regex",
      description: ["Process Helm-sourced charts"],
      managerFilePatterns: ["/(^|/)metadata\\.ya?ml$/"],
      matchStrings: [
        "artifactName:\\s+(?<artifactName>\\S+)\\s+source:\\s+helm:\\s+registry:\\s+(?<registryUrl>\\S+)\\s+version:\\s+[\\\"']?(?<currentValue>[^\\s\\\"']+)[\\\"']?(?:\\s+chart:\\s+(?<chart>\\S+))?",
      ],
      datasourceTemplate: "helm",
      depNameTemplate: "{{#if chart}}{{chart}}{{else}}{{artifactName}}{{/if}}",
    },
    {
      customType: "regex",
      description: ["Process git-sourced charts"],
      managerFilePatterns: ["/(^|/)metadata\\.ya?ml$/"],
      matchStrings: [
        "source:\\s+git:\\s+repository:\\s+(?<depName>\\S+)\\s+path:\\s+\\S+\\s+tag:\\s+(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "git-tags",
      versioningTemplate: "semver-coerced",
    },
  ],
  packageRules: [
    {
      description: "Use integer versioning for Kuberhealthy chart revisions",
      matchDatasources: ["helm"],
      matchPackageNames: ["kuberhealthy"],
      versioning: "regex:^(?<major>\\d+)$",
    },
    {
      description: "Do not digest-pin mise-managed tools",
      matchManagers: ["mise"],
      pinDigests: false,
    },
    {
      description: "Open mirrored chart updates for review",
      matchDatasources: ["helm", "git-tags"],
      automerge: false,
      prCreation: "immediate",
      prHourlyLimit: 0,
      prConcurrentLimit: 10,
      branchConcurrentLimit: 10,
    },
  ],
}
